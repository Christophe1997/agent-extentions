{
  "name": "agent-extensions",
  "owner": {
    "name": "Christophe1997",
    "email": "hey_christophe@outlook.com"
  },
  "metadata": {
    "description": "Marketplace for Claude Code extensions",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "review-blog",
      "source": "./plugins/review-blog",
      "description": "Review Chinese blog posts for writing style, punctuation, and formatting issues.",
      "version": "1.0.0",
      "author": {
        "name": "Christophe1997",
        "email": "hey_christophe@outlook.com"
      },
      "category": "content-creation",
      "keywords": ["blog", "review", "chinese", "writing-style", "markdown"]
    },
    {
      "name": "llm-doc",
      "source": "./plugins/llm-doc",
      "description": "Documentation standards for AI coding agents: AGENTS.md format and conventional commit messages",
      "version": "0.5.0",
      "author": {
        "name": "Christophe1997",
        "email": "hey_christophe@outlook.com"
      },
      "category": "developer-tools",
      "keywords": ["agents.md", "ai", "documentation", "commit", "conventional-commits", "coding-agents"]
    },
    {
      "name": "show-me-the-session",
      "source": "./plugins/show-me-the-session",
      "description": "Export Claude Code session transcripts to solarized-light HTML with pagination support. Features: auto session detection, split output for large sessions, configurable page size.",
      "version": "0.8.0",
      "author": {
        "name": "Christophe1997",
        "email": "hey_christophe@outlook.com"
      },
      "category": "developer-tools",
      "keywords": ["session", "export", "html", "transcript", "solarized"]
    },
    {
      "name": "permission-notification",
      "source": "./plugins/permission-notification",
      "description": "Sends macOS notifications when Claude Code needs permission to execute commands",
      "version": "0.1.0",
      "author": {
        "name": "Christophe1997",
        "email": "hey_christophe@outlook.com"
      },
      "category": "productivity",
      "keywords": ["notification", "permission", "macos", "alert"]
    }
  ]
}
